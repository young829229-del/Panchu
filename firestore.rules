rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isPrimaryAdmin() {
      return isSignedIn() && 
        (request.auth.token.email == 'young829229@gmail.com' || 
         request.auth.token.email == 'Young829229@gmail.com' ||
         request.auth.token.email == 'npdraggers111@gmail.com' ||
         request.auth.token.email == 'Npdraggers111@gmail.com');
    }

    function isAdmin() {
      return isPrimaryAdmin() || 
        (isSignedIn() && (
          request.auth.token.admin == true ||
          exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        ));
    }

    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.price is number && data.price >= 0;
    }

    function isValidOrder(data) {
      return data.orderId is string && data.orderId.size() > 0 && data.orderId.size() <= 100 &&
             data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 150 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() <= 50 &&
             (
               (data.shippingAddress is string && data.shippingAddress.size() > 0 && data.shippingAddress.size() <= 500) ||
               (data.address is string && data.address.size() > 0 && data.address.size() <= 500)
             ) &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 100 &&
             (
               (data.totalAmount is number && data.totalAmount >= 0) ||
               (data.total is number && data.total >= 0)
             ) &&
             (
               data.orderStatus == 'Pending' || data.orderStatus == 'Confirmed' || data.orderStatus == 'Shipped' || data.orderStatus == 'Delivered' || data.orderStatus == 'Collected' || data.orderStatus == 'Cancelled' ||
               data.status == 'Pending' || data.status == 'Confirmed' || data.status == 'Shipped' || data.status == 'Delivered' || data.status == 'Collected' || data.status == 'Cancelled'
             );
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Products Collection: Public read, Admin write, customer stock updates on order
    match /products/{productId} {
      allow read, get, list: if true;
      allow create, delete: if isAdmin() && isValidId(productId);
      allow update: if isValidId(productId) && (
        isAdmin() ||
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'inStock', 'updatedAt'])
        )
      );
    }

    // Banners Collection: Public read, Admin write
    match /banners/{bannerId} {
      allow read, get, list: if true;
      allow create, update, delete: if isAdmin() && isValidId(bannerId);
    }

    // Orders Collection: Unauthenticated / guest create, Only Authenticated Admin can read, list, update, or delete
    match /orders/{orderId} {
      allow create: if isValidId(orderId) && isValidOrder(incoming());
      allow read, get, list, update, delete: if isAdmin();
    }

    // Users Collection: Customer profile documents
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      allow read: if isAdmin();
    }

    // Admin Users Collection: Signed-in users can check admin role, Admins can write
    match /admin_users/{adminUserId} {
      allow read, get, list: if isSignedIn();
      allow write: if isAdmin();
    }

    // Admins Collection: Backwards compatibility
    match /admins/{adminId} {
      allow read, get, list: if isSignedIn();
      allow write: if isAdmin();
    }

    // System connection test doc
    match /system/{docId} {
      allow read, get, list: if true;
    }
  }
}


